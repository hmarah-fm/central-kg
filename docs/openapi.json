  "components": {
    "schemas": {
      "InfraflexTelemetryBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/InfraflexTelemetryEvent"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "InfraflexTelemetryBatch"
      },
      "InfraflexTelemetryEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Id"
          },
          "asset_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Asset Id"
          },
          "source_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id"
          },
          "metric_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Metric Name"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "maxLength": 32,
            "title": "Unit",
            "default": ""
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "asset_id",
          "source_id",
          "metric_name",
          "value",
          "observed_at"
        ],
        "title": "InfraflexTelemetryEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SPARQLQuery": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SPARQLQuery"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}